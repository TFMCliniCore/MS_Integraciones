PORT=3009
POSTGRES_USER=integraciones_user
POSTGRES_PASSWORD=secret
POSTGRES_DB=ms_integraciones
POSTGRES_PORT=5438
DATABASE_URL=postgresql://integraciones_user:secret@localhost:5438/ms_integraciones?schema=public

# ── Email ─────────────────────────────────────────────────────────────────────
EMAIL_PROVIDER=smtp
EMAIL_FROM=noreply@clinicore.com
EMAIL_FROM_NAME=CliniCore

# SMTP (cuando EMAIL_PROVIDER=smtp)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_app_password
SMTP_SECURE=false

# Resend (cuando EMAIL_PROVIDER=resend)
RESEND_API_KEY=re_xxxxxxxxxxxxx

# ── WhatsApp ──────────────────────────────────────────────────────────────────
WHATSAPP_PROVIDER=twilio

# Twilio (cuando WHATSAPP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Meta Cloud API (cuando WHATSAPP_PROVIDER=meta)
META_PHONE_NUMBER_ID=1234567890
META_ACCESS_TOKEN=EAAxxxxxxxxx
META_WABA_ID=1234567890

# ── Videollamadas ─────────────────────────────────────────────────────────────
VIDEOLLAMADA_PROVIDER=google_meet
MEET_DURACION_MINUTOS=60

# Google Meet (OAuth2 — cuando VIDEOLLAMADA_PROVIDER=google_meet)
GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxx
GOOGLE_REFRESH_TOKEN=1//xxxxxxxxxxxxxxxxxx
GOOGLE_CALENDAR_ID=primary

# Zoom (cuando VIDEOLLAMADA_PROVIDER=zoom)
ZOOM_ACCOUNT_ID=xxxxxxxxxx
ZOOM_CLIENT_ID=xxxxxxxxxx
ZOOM_CLIENT_SECRET=xxxxxxxxxx

# ── Backups ───────────────────────────────────────────────────────────────────
BACKUP_PATH=/backups
BACKUP_ENCRYPT_KEY=clave-aes-256-de-32-caracteres!!
BACKUP_NOTIFY_EMAILS=admin@clinicore.com,devops@clinicore.com

# S3 / compatible (MinIO, Cloudflare R2, etc.)
S3_ENABLED=false
S3_BUCKET=clinicore-backups
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# ── Otros microservicios ──────────────────────────────────────────────────────
MS_ENTIDADES_URL=http://host.docker.internal:3001/api/v1

# ── Opcionales ────────────────────────────────────────────────────────────────
EMAIL_MULTISUCURSAL=false
SMS_FALLBACK=false
